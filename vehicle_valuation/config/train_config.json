{
  "data": {
    "path": "./data/vehicle_timeline.csv",
    "window_size": 10,
    "stride": 5,
    "prediction_horizons": [7, 30, 90],
    "train_split": 0.8,
    "val_split": 0.2,
    "random_state": 42
  },
  "model": {
    "temporal_feature_dim": 8,
    "num_systems": 20,
    "d_model": 256,
    "nhead": 8,
    "num_layers": 6,
    "dropout": 0.1,
    "max_sequence_length": 50
  },
  "training": {
    "batch_size": 64,
    "num_workers": 4,
    "epochs": 10,
    "patience": 15,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "device": "cpu",
    "gradient_clip_norm": 1.0,
    "save_best_only": true
  },
  "output": {
    "save_dir": "./output",
    "save_best_model": true,
    "save_history": true,
    "evaluation_metrics": ["loss", "accuracy", "precision", "recall", "f1"]
  },
  "logging": {
    "log_level": "INFO",
    "log_dir": "./logs",
    "tensorboard": false,
    "save_plots": true
  }
}